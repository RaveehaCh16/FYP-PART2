<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background Shadow -->
    <item
        android:right="2dp"
        android:left="2dp"
        android:top="2dp"
        android:bottom="2dp">
        <shape>
            <solid android:color="#88000000"/> <!-- Shadow color -->
            <corners android:radius="16dp"/> <!-- Rounded corners -->
        </shape>
    </item>

    <!-- Button Gradient -->
    <item>
        <shape>
            <gradient
                android:startColor="#FFFFFF"
            android:centerColor="#76B56D"
            android:endColor="#76B56D"
            android:angle="270"/>
            <corners android:radius="16dp"/> <!-- Rounded corners -->
            <stroke
                android:color="#A0A0A0"
            android:width="2dp"/>    <!-- Border width -->
        </shape>
    </item>
</layer-list>
