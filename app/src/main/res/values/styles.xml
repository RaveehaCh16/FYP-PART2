<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorButtonNormal">@null</item>
    </style>

    <!-- New style for word grid cells -->
    <!-- styles.xml -->
    <style name="WordCell">
        <item name="android:layout_width">0dp</item> <!-- Ensures cells take up equal width -->
        <item name="android:layout_height">0dp</item> <!-- Ensures cells take up equal height -->
        <item name="android:layout_rowWeight">1</item> <!-- Distributes height equally across all rows -->
        <item name="android:layout_columnWeight">1</item> <!-- Distributes width equally across all columns -->
        <item name="android:gravity">center</item>
        <item name="android:padding">6dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#000000</item>
        <item name="android:background">@drawable/word_cell_background</item>
        <item name="android:layout_margin">4dp</item> <!-- Space between cells -->

    </style>

    <style name="DayBoxStyle">
        <item name="android:layout_width">200dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">10dp</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">18sp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:background">#FFFFFF</item>
    </style>

</resources>
