<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backscreen">

    <TextView
        android:id="@+id/topLabel"
        android:layout_width="330dp"
        android:layout_height="wrap_content"
        android:text="          Speak Sentence:\n\n\n\n\n       Pink flowers bloom"
        android:textColor="#000000"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginTop="40dp"
        android:layout_centerHorizontal="true" />

    <LinearLayout
        android:layout_below="@id/topLabel"
        android:layout_above="@+id/navigationLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="1dp"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:layout_marginTop="-60dp">

        <Button
            android:id="@+id/speakButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:background="@drawable/button_3d_round"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:text="Tap to Speak"
            android:textSize="20sp"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/resultTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="                         "
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_textview"
            android:padding="12dp"
            android:textSize="20sp"
            android:visibility="gone"/>


        <TextView
            android:id="@+id/statusTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="                             "
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_textview"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#000000"
            android:visibility="gone"/>

        <Button
            android:id="@+id/learnPronunciationButton"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Learn to Pronounce"
            android:background="@drawable/rounded_textview"
            android:layout_marginTop="10dp"
            android:visibility="gone" />
    </LinearLayout>

    <nl.dionsegijn.konfetti.xml.KonfettiView
        android:id="@+id/konfettiView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true" />

    <LinearLayout
        android:id="@+id/navigationLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/backButton"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="Back"
            android:textSize="18sp"
            android:background="@drawable/button_3d_round"/>

        <View
            android:layout_width="16dp"
            android:layout_height="0dp" />

        <Button
            android:id="@+id/nextButton"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="Next"
            android:textSize="18sp"
            android:background="@drawable/button_3d_round"  />
    </LinearLayout>
</RelativeLayout>
