<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/gifBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/winter_qs" />

    <!-- Question Text -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:text="What was the color of the snowman’s hat?"
        android:background="#FFF5E5"
        android:textColor="#8B4513"
        android:textSize="28sp"
        android:layout_marginTop="60dp"
        android:layout_marginStart="30dp"
        android:padding="16dp"
        android:shadowColor="#80000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4" />

    <!-- Option Buttons -->
    <LinearLayout
        android:id="@+id/optionsLayout"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="180dp"
        android:layout_marginStart="40dp">

        <Button
            android:id="@+id/option1"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:text="yellow and green"
            android:textColor="#000000"
            android:backgroundTint="#FF6F61" /> <!-- Coral Pink -->

        <Button
            android:id="@+id/option2"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:text="black and yellow"
            android:textColor="#000000"
            android:backgroundTint="#6BCEB3"
            android:layout_marginTop="10dp" /> <!-- Mint Green -->

        <Button
            android:id="@+id/option3"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:text="black and red"
            android:textColor="#000000"
            android:backgroundTint="#FFD166"
            android:layout_marginTop="10dp" /> <!-- Warm Yellow -->

        <Button
            android:id="@+id/option4"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:text="red and blue"
            android:textColor="#000000"
            android:backgroundTint="#9B5DE5"
            android:layout_marginTop="10dp" /> <!-- Purple Grape -->
    </LinearLayout>


    <!-- Bottom Navigation Buttons -->
    <LinearLayout
        android:id="@+id/navigationLayout"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="50dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:translationX="80dp"
        android:gravity="center">

        <View
            android:layout_width="16dp"
            android:layout_height="0dp" />

        <Button
            android:id="@+id/nextButton"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="Next"
            android:textSize="18sp"
            android:background="@drawable/button_3d_round" />
    </LinearLayout>
</FrameLayout>
