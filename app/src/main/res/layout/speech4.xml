<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backscreen">

    <!-- Top Center Label -->
    <TextView
        android:id="@+id/topLabel"
        android:layout_width="330dp"
        android:layout_height="wrap_content"
        android:text="              Speak Sentence: \n \n \n\n\n\nThere was a cat that ate a rat, and after that sat on a yellow mat."
        android:textColor="#000000"
        android:textSize="25sp"
        android:textStyle="bold"
        android:layout_marginTop="40dp"
        android:layout_centerHorizontal="true" />


    <!-- Main content area -->
    <LinearLayout
        android:layout_below="@id/topLabel"
        android:layout_above="@+id/navigationLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:layout_marginTop="-125dp">



        <Button
            android:id="@+id/speakButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:background="@drawable/button_3d_round"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:text="Tap to Speak"
            android:textSize="20sp"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/resultTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="                         "
            android:layout_marginBottom="30dp"
            android:background="@drawable/button_3d_round"
            android:padding="5dp"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/statusTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="                             "
            android:background="@drawable/button_3d_round"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#000000" />

        <Button
            android:id="@+id/learnPronunciationButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Learn to Pronounce"
            android:background="@drawable/button_3d_round"
            android:layout_marginTop="10dp"
            android:visibility="gone" />
    </LinearLayout>
    <!-- Confetti celebration view (added this!) -->
    <nl.dionsegijn.konfetti.xml.KonfettiView
        android:id="@+id/konfettiView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true" />

    <LinearLayout
        android:id="@+id/navigationLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/backButton"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="Back"
            android:textSize="18sp"
            android:background="@drawable/button_3d_round"/>

        <View
            android:layout_width="16dp"
            android:layout_height="0dp" />

        <Button
            android:id="@+id/nextButton"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="Next"
            android:textSize="18sp"
            android:background="@drawable/button_3d_round"  />
    </LinearLayout>
</RelativeLayout>
